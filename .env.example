# Copy the values you need into your local shell profile, launchd plist,
# direnv file, or another local-only environment file.

# ============================================================================
# PROJECT PATHS
# ============================================================================
LARK_AGENT_BRIDGE_WORKSPACE_ROOT=/path/to/workspace
LARK_AGENT_BRIDGE_GUIDEENGINE_REPO=/path/to/workspace/xp/guideengine/.worktrees/os6_xpdev

# ============================================================================
# FEISHU BOT CREDENTIALS
# ============================================================================
# Get these from: https://open.feishu.cn/app/cli -> 凭证信息
LARK_AGENT_BRIDGE_BOT_OPEN_ID=
LARK_AGENT_BRIDGE_BOT_NAME="My Feishu CLI Bot"

# Comma-separated allowlists for real group usage (empty = all groups allowed)
LARK_AGENT_BRIDGE_ALLOWED_CHATS=
LARK_AGENT_BRIDGE_ALLOWED_USERS=

# ============================================================================
# AI PROVIDER — Choose ONE Preset Below
# ============================================================================

# CC-SWITCH (Recommended for development)
# No API key needed, uses local cc-switch proxy at 127.0.0.1:15721
# export LARK_AGENT_BRIDGE_AI_PRESET="cc-switch"

# OPENAI (Recommended for production)
# Get API key from: https://platform.openai.com/api-keys
export LARK_AGENT_BRIDGE_AI_PRESET="openai"
export LARK_AGENT_BRIDGE_AI_API_KEY="sk-proj-..."

# DEEPSEEK (Low-cost alternative)
# Get API key from: https://platform.deepseek.com/api/keys
# export LARK_AGENT_BRIDGE_AI_PRESET="deepseek"
# export LARK_AGENT_BRIDGE_AI_API_KEY="sk-..."

# ============================================================================
# LEGACY: Local OMLX Endpoint (optional, for knowledge QA)
# ============================================================================
LARK_AGENT_BRIDGE_OMLX_BASE_URL=http://127.0.0.1:8000/v1
LARK_AGENT_BRIDGE_OMLX_MODEL=gemma-4-26b-a4b-it-4bit
LARK_AGENT_BRIDGE_OMLX_API_KEY=your-local-api-key

# ============================================================================
# OPTIONAL: Production Settings
# ============================================================================
# Disable dry-run for production (default: 1 = enabled)
# export LARK_AGENT_BRIDGE_DRY_RUN=0

